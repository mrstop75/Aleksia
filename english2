<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Μάθετε Αγγλικά! - Learn English!</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;700;800&display=swap');
  :root { --pink:#ff6eb4; --dpink:#e91e8c; --violet:#9b59b6; --dviolet:#6c3483; --gold:#ffd700; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Nunito', sans-serif; font-weight: 700; color: #334155; background: linear-gradient(160deg,#2d0050 0%,#6c1a8a 40%,#c0185e 80%,#ff6eb4 100%); background-attachment: fixed; min-height: 100vh; overflow-x: hidden; position: relative; -webkit-user-select: none; user-select: none; touch-action: manipulation; }
  button { font: inherit; }
  a { text-decoration: none; }

  /* Floating decorations */
  .deco { position: fixed; pointer-events: none; z-index: 0; font-size: 2rem; animation: fd 8s ease-in-out infinite; opacity: .45; }
  .deco:nth-child(1) { top: 5%; left: 2%; font-size: 2.4rem; }
  .deco:nth-child(2) { top: 12%; right: 3%; font-size: 1.8rem; animation-delay: 1.2s; }
  .deco:nth-child(3) { top: 32%; left: 1%; animation-delay: 2s; }
  .deco:nth-child(4) { top: 48%; right: 2%; font-size: 2.6rem; animation-delay: .6s; }
  .deco:nth-child(5) { top: 65%; left: 3%; font-size: 1.6rem; animation-delay: 3s; }
  .deco:nth-child(6) { top: 78%; right: 4%; animation-delay: 1.8s; }
  .deco:nth-child(7) { top: 88%; left: 2%; font-size: 2.2rem; animation-delay: 2.5s; }
  .deco:nth-child(8) { top: 22%; left: 46%; font-size: 1.5rem; animation-delay: 4s; }
  @keyframes fd { 0%,100% { transform: translateY(0) rotate(-5deg); } 50% { transform: translateY(-18px) rotate(5deg); } }

  header { position: relative; z-index: 2; text-align: center; padding: 24px 20px 6px; color: white; }
  .unicorn-banner { font-size: 3rem; margin-bottom: 4px; }
  header h1 { font-family: 'Fredoka One', cursive; font-weight: 400; font-size: clamp(1.6rem,5vw,2.8rem); background: linear-gradient(90deg,#fff 20%,#ffd6f0 50%,#ffe066 80%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 2px 8px rgba(255,110,180,.5)); line-height: 1.15; margin-bottom: 0; }
  header p { color: #ffd6f0; font-size: .95rem; margin-top: 5px; opacity: 1; }
  .rainbow-bar { height: 6px; border-radius: 10px; background: linear-gradient(90deg,#ff6b6b,#ff9f43,#ffd700,#6bcb77,#4ecdc4,#6b8cff,#c77dff); max-width: 500px; margin: 10px auto 0; }

  .topbtns { position: relative; z-index: 2; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 10px; }
  .glass { display: inline-block; background: rgba(255,255,255,.18); border: 2px solid rgba(255,255,255,.35); border-radius: 30px; color: #fff; font-family: 'Fredoka One', cursive; font-size: .9rem; padding: 6px 18px; backdrop-filter: blur(4px); cursor: pointer; }

  nav { position: sticky; top: 0; z-index: 100; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; padding: 12px 14px; margin-top: 10px; background: rgba(45,0,80,.55); backdrop-filter: blur(8px); border-bottom: 2px solid rgba(255,255,255,.2); }
  nav button { display: flex; align-items: center; gap: 5px; padding: 7px 15px; border: 2px solid rgba(255,255,255,.3); border-radius: 30px; background: rgba(255,255,255,.15); color: #fff; font-family: 'Fredoka One', cursive; font-weight: 400; font-size: .85rem; cursor: pointer; backdrop-filter: blur(4px); transition: all .2s; }
  nav button:hover { background: rgba(255,255,255,.25); }
  nav button.active { background: linear-gradient(135deg,var(--pink),var(--violet)); border-color: transparent; box-shadow: 0 4px 18px rgba(255,110,180,.5); transform: translateY(-2px); color: #fff; }

  #content { position: relative; z-index: 2; }
  .section { padding: 2rem 1rem 1rem; max-width: 1100px; margin: 0 auto; }
  .section h2 { font-family: 'Fredoka One', cursive; font-weight: 400; font-size: 1.5rem; color: #fff; margin-bottom: 1.2rem; padding-bottom: 0.5rem; border-bottom: 3px solid rgba(255,255,255,.3); display: flex; align-items: center; gap: 8px; text-shadow: 0 2px 8px rgba(0,0,0,.2); }

  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
  .card { background: rgba(255,255,255,.96); border-radius: 24px; padding: 1rem 0.8rem 0.8rem; text-align: center; cursor: pointer; border: 3px solid var(--violet); box-shadow: 0 10px 40px rgba(0,0,0,.2); transition: all 0.2s; user-select: none; }
  .card:hover { border-color: var(--pink); transform: translateY(-3px); box-shadow: 0 12px 34px rgba(255,110,180,.4); }
  .card.playing { border-color: var(--pink); background: #ffe0f5; transform: scale(0.97); }
  .card .emoji { font-size: 2.4rem; margin-bottom: 0.5rem; line-height: 1; filter: drop-shadow(0 4px 8px rgba(0,0,0,.12)); }
  .card .word { font-family: 'Fredoka One', cursive; font-weight: 400; font-size: 1.25rem; color: var(--dviolet); margin-bottom: 2px; }
  .card .meaning { font-size: 0.85rem; color: #555; margin-bottom: 6px; }
  .btn-row { display: flex; gap: 6px; justify-content: center; margin-top: 4px; }
  .btn-en, .btn-el { font-size: 1.1rem; background: #fdf0ff; border: 3px solid #e0c8ff; border-radius: 14px; padding: 3px 9px; cursor: pointer; transition: all 0.15s; }
  .btn-en:hover, .btn-el:hover { background: #f5d6ff; border-color: var(--violet); transform: scale(1.06); }

  /* Phrase cards */
  .phrase-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .phrase-card { background: rgba(255,255,255,.96); border-radius: 24px; padding: 1rem 1rem 0.8rem; border: 3px solid var(--violet); box-shadow: 0 10px 40px rgba(0,0,0,.2); transition: all 0.2s; cursor: pointer; }
  .phrase-card:hover { border-color: var(--pink); transform: translateY(-2px); box-shadow: 0 12px 34px rgba(255,110,180,.4); }
  .phrase-card.playing { border-color: var(--pink); background: #ffe0f5; }
  .phrase-card .p-emoji { font-size: 1.8rem; margin-bottom: 6px; }
  .phrase-card .p-en { font-family: 'Fredoka One', cursive; font-weight: 400; font-size: 1.15rem; color: var(--dviolet); margin-bottom: 3px; }
  .phrase-card .p-el { font-size: 0.9rem; color: #555; margin-bottom: 8px; }

  .toast { position: fixed; top: 16px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg,var(--pink),var(--violet)); color: white; padding: 12px 22px; border-radius: 30px; font-family: 'Fredoka One', cursive; font-weight: 400; font-size: 1.1rem; box-shadow: 0 6px 24px rgba(0,0,0,.3); opacity: 0; transition: opacity 0.3s; pointer-events: none; z-index: 1100; white-space: nowrap; max-width: 90vw; overflow: hidden; text-overflow: ellipsis; text-align: center; }
  .toast.show { opacity: 1; }
  footer { position: relative; z-index: 2; text-align: center; padding: 2rem; color: #ffd6f0; font-size: 0.85rem; margin-top: 2rem; }
  @media (max-width: 500px) { .cards { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); } header h1 { font-size: 1.6rem; } .phrase-cards { grid-template-columns: 1fr; } }

  /* ============================================================
     ENGLISH ALPHABET ACTIVITIES (added)
     ============================================================ */
  #alphabet { position: relative; z-index: 2; }
  #alphabet input, #abcNameOverlay input { -webkit-user-select: text; user-select: text; }

  .stars-hud{display:flex;align-items:center;justify-content:center;gap:8px;margin:0;background:rgba(255,255,255,.12);backdrop-filter:blur(6px);border:2px solid rgba(255,255,255,.25);border-radius:50px;padding:4px 16px;width:fit-content;font-family:'Fredoka One',cursive;font-weight:400;color:#fff;font-size:.9rem;}
  #starCount{color:var(--gold);font-size:1.1rem;}
  .star-burst{position:fixed;pointer-events:none;z-index:999;font-size:2.5rem;animation:burstAnim .9s forwards;}
  @keyframes burstAnim{0%{transform:translateY(0) scale(1);opacity:1;}100%{transform:translateY(-80px) scale(1.8);opacity:0;}}
  .name-change-btn{display:inline-block;margin:0;background:rgba(255,255,255,.18);border:2px solid rgba(255,255,255,.35);border-radius:30px;color:#fff;font-family:'Fredoka One',cursive;font-weight:400;font-size:.9rem;padding:6px 18px;cursor:pointer;backdrop-filter:blur(4px);}

  .atabs{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;padding:14px 0 0;}
  .atab-btn{padding:9px 16px;border:2px solid rgba(255,255,255,.3);border-radius:30px;font-family:'Fredoka One',cursive;font-weight:400;font-size:.88rem;cursor:pointer;background:rgba(255,255,255,.15);color:#fff;backdrop-filter:blur(4px);transition:all .2s;}
  .atab-btn.active{background:linear-gradient(135deg,var(--pink),var(--violet));border-color:transparent;box-shadow:0 4px 18px rgba(255,110,180,.5);transform:translateY(-2px);}
  .atab-btn:hover:not(.active){background:rgba(255,255,255,.25);}
  .acontent{padding:18px 0 0;}
  .asec{display:none;}.asec.active{display:block;}

  /* GRID */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:12px;max-width:960px;margin:0 auto 30px;}
  .letter-card{background:rgba(255,255,255,.95);border-radius:18px;padding:8px 6px 10px;text-align:center;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.18);transition:transform .15s,box-shadow .15s;user-select:none;border:2px solid transparent;overflow:hidden;}
  .letter-card:hover{transform:scale(1.1) rotate(-2deg);box-shadow:0 8px 22px rgba(255,110,180,.45);border-color:var(--pink);}
  .letter-card .upper{font-family:'Fredoka One',cursive;font-size:1.9rem;color:var(--dpink);line-height:1;}
  .letter-card .lower{font-family:'Fredoka One',cursive;font-size:1.25rem;color:var(--violet);}
  .letter-card .lname{font-size:.63rem;color:#bbb;font-weight:700;margin-top:1px;}
  .card-illo{font-size:2.4rem;margin-top:4px;line-height:1;display:block;}

  /* DETAIL */
  .detail-box{max-width:500px;margin:0 auto;background:rgba(255,255,255,.97);border-radius:28px;padding:24px 26px;box-shadow:0 10px 40px rgba(0,0,0,.2);text-align:center;border:3px solid var(--pink);}
  .detail-letters{font-family:'Fredoka One',cursive;font-size:4.5rem;color:var(--dpink);line-height:1;}
  .detail-letters span{color:var(--violet);}
  .detail-name{font-size:1rem;color:#bbb;font-weight:700;margin:3px 0 6px;}
  .detail-illo-wrap{position:relative;width:160px;margin:0 auto 10px;cursor:pointer;}
  .detail-illo{font-size:7rem;line-height:1;display:block;filter:drop-shadow(0 4px 8px rgba(0,0,0,.12));transition:transform .15s;}
  .detail-illo:hover{transform:scale(1.08);}
  .detail-illo-badge{position:absolute;bottom:-4px;right:-4px;background:linear-gradient(135deg,var(--pink),var(--violet));border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;box-shadow:0 2px 8px rgba(0,0,0,.2);cursor:pointer;}
  .detail-word{font-size:1.5rem;font-weight:800;color:#333;}
  .detail-meaning{font-size:1rem;color:#888;margin-top:2px;}
  .detail-hint{font-size:.93rem;color:#888;margin:5px 0 16px;}
  .back-btn{display:inline-block;margin-top:12px;background:#f0e8ff;color:var(--dviolet);border:none;border-radius:30px;padding:7px 20px;font-size:.9rem;font-family:'Nunito',sans-serif;font-weight:700;cursor:pointer;}
  .detail-nav{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
  .next-letter-btn{background:linear-gradient(135deg,var(--pink),var(--violet));color:#fff;}

  /* PANEL */
  .panel{max-width:580px;margin:0 auto;background:rgba(255,255,255,.96);border-radius:28px;padding:24px 26px;box-shadow:0 10px 40px rgba(0,0,0,.2);text-align:center;border:3px solid var(--violet);}
  .panel h2{font-family:'Fredoka One',cursive;color:var(--dviolet);font-size:1.3rem;margin-bottom:5px;display:block;border:none;padding:0;text-shadow:none;}

  /* QUIZ */
  .quiz-question{font-size:1.1rem;color:#555;font-weight:700;margin-bottom:8px;}
  .quiz-illo-wrap{position:relative;width:fit-content;margin:6px auto 14px;cursor:pointer;}
  .quiz-illo{font-size:7rem;line-height:1;display:block;filter:drop-shadow(0 4px 8px rgba(0,0,0,.1));transition:transform .15s;}
  .quiz-illo:hover{transform:scale(1.06);}
  .quiz-illo-badge{position:absolute;bottom:-4px;right:-4px;background:linear-gradient(135deg,var(--pink),var(--violet));border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:1rem;box-shadow:0 2px 8px rgba(0,0,0,.2);}
  .quiz-options{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-bottom:14px;}
  .opt-btn{background:#fdf0ff;border:3px solid #e0c8ff;border-radius:18px;padding:11px 6px;cursor:pointer;font-family:'Fredoka One',cursive;transition:all .2s;display:flex;flex-direction:column;align-items:center;gap:3px;}
  .opt-btn:hover{background:#f5d6ff;border-color:var(--violet);transform:scale(1.04);}
  .opt-btn.correct{background:#d4f8d4;border-color:#52c752;}
  .opt-btn.wrong{background:#fde0e0;border-color:#f06060;}
  .opt-btn .ol{font-size:1.8rem;color:var(--dpink);line-height:1;}
  .opt-btn .os{font-size:1.1rem;color:var(--violet);}
  .quiz-result{font-size:1.1rem;min-height:30px;font-weight:800;color:var(--dviolet);margin-bottom:11px;}
  .next-btn{background:linear-gradient(135deg,var(--violet),var(--dpink));color:#fff;border:none;border-radius:30px;padding:11px 28px;font-size:.95rem;font-family:'Fredoka One',cursive;cursor:pointer;}
  .score-bar{font-size:.9rem;color:#aaa;margin-top:8px;font-weight:700;}

  /* MATCH */
  .match-cols{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:10px;}
  .match-col{display:flex;flex-direction:column;gap:10px;}
  .match-card{width:88px;height:70px;border-radius:14px;border:3px solid #e0c8ff;background:#fdf0ff;font-family:'Fredoka One',cursive;font-size:1.7rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;user-select:none;flex-direction:column;gap:1px;}
  .match-card .mn{font-size:.56rem;color:#ccc;font-family:'Nunito',sans-serif;font-weight:700;}
  .upper-card{color:var(--dpink);}.lower-card{color:var(--violet);}
  .match-card.selected{border-color:var(--pink);background:#ffe0f5;transform:scale(1.08);}
  .match-card.matched{border-color:#52c752;background:#d4f8d4;cursor:default;}
  .match-card.wrong{border-color:#f06060;background:#fde0e0;}
  .match-result{font-size:1.05rem;font-weight:800;color:var(--dviolet);min-height:24px;margin-top:4px;}
  .new-match-btn{margin-top:10px;background:linear-gradient(135deg,var(--pink),var(--violet));color:#fff;border:none;border-radius:30px;padding:9px 24px;font-size:.95rem;font-family:'Fredoka One',cursive;cursor:pointer;}

  /* TRACING */
  .trace-panel{max-width:560px;margin:0 auto;background:rgba(255,255,255,.96);border-radius:28px;padding:22px 22px;box-shadow:0 10px 40px rgba(0,0,0,.2);text-align:center;border:3px solid var(--pink);}
  .trace-letter-select{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;margin-bottom:14px;}
  .tltr{background:#fdf0ff;border:2px solid #e0c8ff;border-radius:12px;padding:5px 9px;font-family:'Fredoka One',cursive;font-size:1.15rem;color:var(--dpink);cursor:pointer;transition:all .2s;min-width:42px;}
  .tltr:hover{border-color:var(--pink);background:#ffe0f5;}
  .tltr.active{background:linear-gradient(135deg,var(--pink),var(--violet));color:#fff;border-color:transparent;}
  .trace-display{font-family:'Fredoka One',cursive;font-size:2.8rem;color:var(--dpink);margin-bottom:2px;}
  .trace-display span{color:var(--violet);}
  .trace-word{font-size:.95rem;color:#888;margin-bottom:8px;font-weight:700;}
  .canvas-wrap{position:relative;display:inline-block;margin-bottom:8px;}
  #traceCanvas{border-radius:20px;background:#fff8ff;border:3px dashed #e0c8ff;touch-action:none;cursor:crosshair;display:block;}
  .ghost-letter{position:absolute;top:50%;left:50%;transform:translate(-50%,-52%);font-family:'Fredoka One',cursive;font-size:clamp(110px,28vw,170px);color:rgba(200,160,230,0.17);pointer-events:none;user-select:none;line-height:1;}
  .color-row{display:flex;gap:7px;align-items:center;justify-content:center;flex-wrap:wrap;}
  .btn-color{width:32px;height:32px;border-radius:50%;border:3px solid #fff;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.2);padding:0;transition:transform .15s;}
  .btn-color.active-color{transform:scale(1.28);box-shadow:0 0 0 3px var(--gold);}
  .size-row{display:flex;gap:8px;align-items:center;justify-content:center;margin-top:7px;}
  .size-btn{width:32px;height:32px;border-radius:50%;border:3px solid #e0c8ff;background:#fdf0ff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;}
  .size-btn.active-size{border-color:var(--violet);background:#e0c8ff;}
  .size-dot{background:var(--violet);border-radius:50%;}
  .trace-controls{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:10px;}
  .trace-btn{border:none;border-radius:30px;padding:9px 20px;font-size:.9rem;font-family:'Fredoka One',cursive;cursor:pointer;transition:transform .15s;}
  .trace-btn:hover{transform:scale(1.05);}
  .btn-clear{background:#f0e8ff;color:var(--dviolet);}
  .btn-star{background:linear-gradient(135deg,#ffe066,#ffb347);color:#7a4a00;}

  /* TASK BUTTON */
  .speak-task-btn{display:flex;align-items:center;gap:8px;margin:0 auto 16px;background:linear-gradient(135deg,#ffe066,#ffb347);color:#7a4a00;border:none;border-radius:30px;padding:11px 24px;font-size:1rem;font-family:'Fredoka One',cursive;cursor:pointer;box-shadow:0 4px 16px rgba(255,180,0,.4);transition:transform .15s;width:fit-content;}
  .speak-task-btn:hover{transform:scale(1.05);}

  /* STARS */
  .stars-page{max-width:560px;margin:0 auto;background:rgba(255,255,255,.96);border-radius:28px;padding:26px 28px;box-shadow:0 10px 40px rgba(0,0,0,.2);text-align:center;border:3px solid var(--gold);}
  .stars-page h2{font-family:'Fredoka One',cursive;color:var(--dviolet);font-size:1.6rem;display:block;border:none;padding:0;margin-bottom:0;text-shadow:none;}
  .stars-page .big-star{font-size:3.2rem;margin:7px 0;}
  .star-total{font-family:'Fredoka One',cursive;font-size:3rem;color:var(--gold);}
  .star-label{color:#aaa;font-size:.88rem;margin-bottom:16px;font-weight:700;}
  .badges{display:flex;flex-wrap:wrap;gap:11px;justify-content:center;margin-top:10px;}
  .badge{background:#f8f0ff;border-radius:14px;padding:11px 12px;border:2px solid #e0c8ff;text-align:center;min-width:96px;opacity:.35;transition:all .3s;}
  .badge.earned{opacity:1;border-color:var(--gold);background:linear-gradient(135deg,#fff9e6,#fff0f8);box-shadow:0 4px 14px rgba(255,215,0,.3);}
  .badge .badge-icon{font-size:1.8rem;}
  .badge .badge-name{font-size:.75rem;font-weight:800;color:var(--dviolet);margin-top:3px;}
  .badge .badge-req{font-size:.7rem;color:#bbb;}
  .progress-wrap{background:#f0e8ff;border-radius:20px;height:15px;margin:13px 0 5px;overflow:hidden;}
  .progress-fill{height:100%;border-radius:20px;background:linear-gradient(90deg,var(--pink),var(--violet));transition:width .5s;}
  .progress-label{font-size:.85rem;color:#999;font-weight:700;}
