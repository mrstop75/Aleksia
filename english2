  abcStars+=n;
  abcUpdateBadges();
  for(let i=0;i<Math.min(n,4);i++){
    setTimeout(()=>{
      const el=document.createElement('div');el.className='star-burst';el.textContent='⭐';
      el.style.left=(x||window.innerWidth/2)+'px';el.style.top=(y||window.innerHeight/2)+'px';
      document.body.appendChild(el);setTimeout(()=>el.remove(),1000);
    },i*130);
  }
}

// ── SUB-TABS ──
function abcTab(id,btn){
  document.querySelectorAll('#alphabet .asec').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('#alphabet .atab-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('asec-'+id).classList.add('active');
  if(btn)btn.classList.add('active');
  if(id==='quiz'&&!abcQuizInit)abcInitQuiz();
  if(id==='match')abcNewMatchRound();
  if(id==='trace')abcInitTrace();
}

// ── BADGES ──
function abcBuildBadges(){
  const g=document.getElementById('badgeGrid');
  ABC_BADGES.forEach(b=>{
    const d=document.createElement('div');d.className='badge';
    d.innerHTML=`<div class="badge-icon">${b.icon}</div><div class="badge-name">${b.name}</div><div class="badge-req">${b.req} ⭐</div>`;
    g.appendChild(d);
  });
  abcUpdateBadges();
}
function abcUpdateBadges(){
  document.getElementById('starCount').textContent=abcStars;
  document.getElementById('bigStarCount').textContent=abcStars;
  const nb=ABC_BADGES.find(b=>abcStars<b.req);
  const idx=nb?ABC_BADGES.indexOf(nb):ABC_BADGES.length;
  const pr=idx>0?ABC_BADGES[idx-1].req:0;
  const nr=nb?nb.req:ABC_BADGES[ABC_BADGES.length-1].req;
  const pct=nb?Math.min(100,((abcStars-pr)/(nr-pr))*100):100;
  document.getElementById('progressFill').style.width=pct+'%';
  document.getElementById('progressLabel').textContent=nb
    ?`${nr-abcStars} αστέρια ακόμα για το "${nb.name}"! 💜`
    :'🏆 Τα κέρδισες όλα! Είσαι καταπληκτική!';
  document.querySelectorAll('#badgeGrid .badge').forEach((el,i)=>el.classList.toggle('earned',abcStars>=ABC_BADGES[i].req));
}

// ── ALPHABET ──
let abcCurrent=null;
function abcSpeakCurrent(){
  if(abcCurrent)abcSay([[abcCurrent.say,'en'],[abcCurrent.word,'en']]);
}
function abcBuildGrid(){
  const g=document.getElementById('alphaGrid');
  ABC.forEach(d=>{
    const c=document.createElement('div');c.className='letter-card';
    c.innerHTML=`<div class="upper">${d.l}</div><div class="lower">${d.s}</div><span class="card-illo">${d.illo}</span>`;
    c.onclick=(e)=>abcOpenDetail(d,e);
    g.appendChild(c);
  });
}
function abcOpenDetail(d,e){
  abcCurrent=d;
  document.getElementById('alphaGrid').style.display='none';
  document.getElementById('detailView').style.display='block';
  document.getElementById('dLetters').innerHTML=`${d.l} <span>${d.s}</span>`;
  document.getElementById('dIllo').textContent=d.illo;
  document.getElementById('dWord').textContent=d.word;
  document.getElementById('dMeaning').textContent=d.mean;
  document.getElementById('dHint').textContent=d.end?'"'+d.l+'" at the end of '+d.word:'"'+d.l+'" for '+d.word;
  const rect=e&&e.target?e.target.getBoundingClientRect():null;
  abcAddStars(1,rect?rect.left:null,rect?rect.top:null);
  abcSay([[d.say,'en'],[d.word,'en']]);
}
function abcNextLetter(){
  if(!abcCurrent)return;
  const i=ABC.indexOf(abcCurrent);
  abcOpenDetail(ABC[(i+1)%ABC.length]);
}
function abcShowGrid(){
  document.getElementById('alphaGrid').style.display='grid';
  document.getElementById('detailView').style.display='none';
  abcCurrent=null;
}

// ── QUIZ ──
let abcQuizInit=false,abcQuizScore=0,abcQuizTotal=0,abcQuizActive=false,abcQuizCorrect=null;
function abcInitQuiz(){abcQuizInit=true;abcNextQuiz();}
function abcSpeakQuizWord(){if(abcQuizCorrect)abcSay([[abcQuizCorrect.word,'en']]);}
function abcNextQuiz(){
  abcQuizActive=true;
  document.getElementById('qResult').textContent='';
  abcQuizCorrect=ABC[Math.floor(Math.random()*ABC.length)];
  document.getElementById('qIllo').textContent=abcQuizCorrect.illo;
  document.getElementById('qQuestion').textContent=abcQuizCorrect.end
    ? 'Με ποιο γράμμα τελειώνει αυτή η εικόνα στα αγγλικά;'
    : 'Με ποιο γράμμα αρχίζει αυτή η εικόνα στα αγγλικά;';
  const opts=[abcQuizCorrect];
  while(opts.length<4){const r=ABC[Math.floor(Math.random()*ABC.length)];if(!opts.find(o=>o.l===r.l))opts.push(r);}
  opts.sort(()=>Math.random()-.5);
  const container=document.getElementById('qOptions');container.innerHTML='';
  opts.forEach(o=>{
    const b=document.createElement('button');b.className='opt-btn';
    b.innerHTML=`<span class="ol">${o.l}</span><span class="os">${o.s}</span>`;
    b.onclick=(ev)=>{
      if(!abcQuizActive)return;
      abcQuizActive=false;abcQuizTotal++;
      const rect=ev.currentTarget.getBoundingClientRect();
      if(o.l===abcQuizCorrect.l){
        b.classList.add('correct');
        const praise = abcChildName ? `Μπράβο ${abcChildName}!` : 'Μπράβο!';
        document.getElementById('qResult').textContent=`🎉 ${praise}`;
        abcQuizScore++;abcAddStars(2,rect.left+rect.width/2,rect.top);
        abcSay([[praise,'el'],[abcQuizCorrect.word+(abcQuizCorrect.end?' ends with ':' starts with ')+abcQuizCorrect.say,'en']]);
      } else {
        b.classList.add('wrong');
        container.querySelectorAll('.opt-btn').forEach(btn=>{if(btn.querySelector('.ol').textContent===abcQuizCorrect.l)btn.classList.add('correct');});
        document.getElementById('qResult').textContent=`Ήταν το ${abcQuizCorrect.l} — ${abcQuizCorrect.word}!`;
        abcSay([[abcQuizCorrect.word+(abcQuizCorrect.end?' ends with ':' starts with ')+abcQuizCorrect.say,'en'],['Δοκίμασε ξανά!','el']]);
      }
      document.getElementById('qScore').textContent=`⭐ Σκορ: ${abcQuizScore} / ${abcQuizTotal}`;
    };
    container.appendChild(b);
  });
}

// ── MATCH ──
let abcMatchSelected=null,abcMatchPairs=[],abcMatchDone=0;
function abcNewMatchRound(){
  abcMatchSelected=null;abcMatchDone=0;
  document.getElementById('matchResult').textContent='';
  const picked=[...ABC].sort(()=>Math.random()-.5).slice(0,5);
  abcMatchPairs=picked;
  abcRenderMatch('upperCol',[...picked].sort(()=>Math.random()-.5),'upper-card',true);
  abcRenderMatch('lowerCol',[...picked].sort(()=>Math.random()-.5),'lower-card',false);
}
function abcRenderMatch(colId,items,cls,isUpper){
  const col=document.getElementById(colId);col.innerHTML='';
  items.forEach(d=>{
    const c=document.createElement('div');c.className=`match-card ${cls}`;
    c.innerHTML=`${isUpper?d.l:d.s}`;
    c.dataset.letter=d.l;c.dataset.isUpper=isUpper?'1':'0';
    c.onclick=(e)=>abcHandleMatch(c,d,e);
    col.appendChild(c);
  });
}
function abcHandleMatch(card,d,e){
  if(card.classList.contains('matched'))return;
  abcSay([[d.say,'en']]);
  if(!abcMatchSelected){abcMatchSelected=card;card.classList.add('selected');}
  else{
    if(abcMatchSelected===card){card.classList.remove('selected');abcMatchSelected=null;return;}
    if(abcMatchSelected.dataset.letter===card.dataset.letter&&abcMatchSelected.dataset.isUpper!==card.dataset.isUpper){
      abcMatchSelected.classList.remove('selected');abcMatchSelected.classList.add('matched');
      card.classList.add('matched');abcMatchSelected=null;abcMatchDone++;
      const rect=card.getBoundingClientRect();
      abcAddStars(1,rect.left+rect.width/2,rect.top);
      abcSay([['Μπράβο!','el']]);
      if(abcMatchDone===abcMatchPairs.length){
        const praise = abcChildName ? `Τα ταίριαξες όλα, ${abcChildName}!` : 'Τα ταίριαξες όλα!';
        document.getElementById('matchResult').textContent=`🏆 ${praise}`;
        abcAddStars(3,window.innerWidth/2,window.innerHeight/3);
        abcSay([[praise,'el']]);
      }
    } else {
      const first=abcMatchSelected;
      first.classList.add('wrong');card.classList.add('wrong');
      abcSay([['Δοκίμασε ξανά!','el']]);
      abcMatchSelected=null;
      setTimeout(()=>{first.classList.remove('wrong','selected');card.classList.remove('wrong');},700);
    }
  }
}

// ── TRACING ──
let abcTraceIdx=0,abcDrawing=false,abcTraceColor='#e91e8c',abcTraceSize=14,abcTraceCase='upper';
const ABC_COLORS=['#e91e8c','#9b59b6','#3498db','#27ae60','#e67e22','#e74c3c','#f39c12','#1abc9c'];
const ABC_SIZES=[8,14,22];

function abcInitTrace(){
  if(document.getElementById('traceLetterBtns').children.length>0){
    abcUpdateGhost(); return;
  }
  const row=document.getElementById('traceLetterBtns');
  ABC.forEach((d,i)=>{
    const b=document.createElement('button');b.className='tltr'+(i===0?' active':'');
    b.textContent=d.l;b.onclick=()=>abcSelectTraceLetter(i,b);
    row.appendChild(b);
  });
  const cr=document.getElementById('colorRow');
  ABC_COLORS.forEach((c,i)=>{
    const b=document.createElement('button');b.className='btn-color'+(i===0?' active-color':'');
    b.style.background=c;
    b.onclick=()=>{abcTraceColor=c;document.querySelectorAll('.btn-color').forEach(x=>x.classList.remove('active-color'));b.classList.add('active-color');};
    cr.appendChild(b);
  });
  const sr=document.getElementById('sizeRow');
  ABC_SIZES.forEach((s,i)=>{
    const b=document.createElement('button');b.className='size-btn'+(i===1?' active-size':'');
    const dot=document.createElement('div');dot.className='size-dot';dot.style.width=s*0.7+'px';dot.style.height=s*0.7+'px';
    b.appendChild(dot);
    b.onclick=()=>{abcTraceSize=s;document.querySelectorAll('.size-btn').forEach(x=>x.classList.remove('active-size'));b.classList.add('active-size');};
    sr.appendChild(b);
  });
  document.getElementById('traceUpper').onclick=()=>abcSetTraceCase('upper');
  document.getElementById('traceLower').onclick=()=>abcSetTraceCase('lower');
  abcTraceCase='upper';
  abcSelectTraceLetter(0,row.querySelector('.tltr'));
  abcSetupCanvas();
}

function abcSelectTraceLetter(i,btn){
  abcTraceIdx=i;
  document.querySelectorAll('#traceLetterBtns .tltr').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const d=ABC[i];
  document.getElementById('traceDisplay').innerHTML=`${d.l} <span>${d.s}</span>`;
  document.getElementById('traceWord').textContent=d.illo+' '+d.word;
  abcUpdateGhost();
  abcClearCanvas();
  abcSay([[d.say,'en'],[d.word,'en']]);
}
function abcSetTraceCase(c){
  abcTraceCase=c;
  document.getElementById('traceUpper').classList.toggle('active',c==='upper');
  document.getElementById('traceLower').classList.toggle('active',c==='lower');
  abcUpdateGhost();
  abcClearCanvas();
  abcSay([[ABC[abcTraceIdx].say,'en']]);
}
function abcUpdateGhost(){
  document.getElementById('ghostLetter').textContent=abcTraceCase==='upper'?ABC[abcTraceIdx].l:ABC[abcTraceIdx].s;
}
function abcSetupCanvas(){
  const canvas=document.getElementById('traceCanvas');
  const ctx=canvas.getContext('2d');
  const w=Math.min(320,canvas.parentElement.clientWidth-6);
  canvas.width=w;canvas.height=Math.round(w*0.875);
  canvas.style.width=w+'px';canvas.style.height=Math.round(w*0.875)+'px';
  function pos(e){
    const r=canvas.getBoundingClientRect();
    const src=e.touches?e.touches[0]:e;
    return {x:src.clientX-r.left,y:src.clientY-r.top};
  }
  canvas.addEventListener('mousedown',e=>{abcDrawing=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);});
  canvas.addEventListener('mousemove',e=>{if(!abcDrawing)return;abcDraw(ctx,pos(e));});
  canvas.addEventListener('mouseup',()=>{abcDrawing=false;ctx.beginPath();});
  canvas.addEventListener('mouseleave',()=>{abcDrawing=false;ctx.beginPath();});
  canvas.addEventListener('touchstart',e=>{e.preventDefault();abcDrawing=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);},{passive:false});
  canvas.addEventListener('touchmove',e=>{e.preventDefault();if(!abcDrawing)return;abcDraw(ctx,pos(e));},{passive:false});
  canvas.addEventListener('touchend',()=>{abcDrawing=false;ctx.beginPath();});
}
function abcDraw(ctx,p){
  ctx.lineWidth=abcTraceSize;ctx.lineCap='round';ctx.lineJoin='round';ctx.strokeStyle=abcTraceColor;
  ctx.lineTo(p.x,p.y);ctx.stroke();ctx.beginPath();ctx.moveTo(p.x,p.y);
}
function abcClearCanvas(){document.getElementById('traceCanvas').getContext('2d').clearRect(0,0,9999,9999);}
function abcPraiseTrace(){
  abcAddStars(2,window.innerWidth/2,200);
  const praise = abcChildName ? `Μπράβο ${abcChildName}!` : 'Μπράβο!';
  abcSay([[praise,'el'],['You wrote the letter '+ABC[abcTraceIdx].say+'!','en'],['Πολύ ωραία!','el']]);
}

