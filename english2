<nav id="nav"></nav>
<!-- ENGLISH ALPHABET ACTIVITIES (added) -->
<div class="section" id="alphabet">
  <h2>🔤 Αλφάβητο (ABC)</h2>

  <div class="atabs">
    <button class="atab-btn active" onclick="abcTab('alphabet',this)">🔤 Αλφάβητο</button>
    <button class="atab-btn" onclick="abcTab('quiz',this)">🎯 Κουίζ</button>
    <button class="atab-btn" onclick="abcTab('match',this)">🔗 Ταίριαξε</button>
    <button class="atab-btn" onclick="abcTab('trace',this)">✏️ Γράψε</button>
    <button class="atab-btn" onclick="abcTab('stars',this)">⭐ Αστέρια</button>
  </div>

