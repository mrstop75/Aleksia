// Built-in speech synthesis (Zero audio files needed!)
function speak(text, lang) {
  if (!('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel();
  const ut = new SpeechSynthesisUtterance(text);
  ut.lang = lang === 'en' ? 'en-US' : 'el-GR';
  ut.rate = 0.85; // slightly slower for kids
  window.speechSynthesis.speak(ut);
}

function speakBoth(enWord, elWord) {
  if (!('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel();
  const uEn = new SpeechSynthesisUtterance(enWord);
  uEn.lang = 'en-US';
  uEn.rate = 0.85;

  const uEl = new SpeechSynthesisUtterance(elWord);
  uEl.lang = 'el-GR';
  uEl.rate = 0.85;

  uEn.onend = () => window.speechSynthesis.speak(uEl);
  window.speechSynthesis.speak(uEn);
}

